{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nick', 'createdAt'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "nicks": {
      "$nick": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$nick.matches(/^[a-z0-9가-힣]{2,8}$/) && newData.val() === auth.uid"
      }
    },
    "presence": {
      "$map": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nick', 'x', 'y'])",
          "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 2000" },
          "vx": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
          "face": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)" },
          "air": { ".validate": "newData.isBoolean()" },
          "z": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 4000" },
          "yaw": { ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10" },
          "$other": { ".validate": false }
        }
      }
    },
    "rafts": {
      ".indexOn": ["t"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['cells', 'dock', 'nick'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "cells": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24" },
        "dock": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "t": { ".validate": "newData.isNumber()" },
        "devs": {
          "$i": {
            ".validate": "newData.hasChildren(['id', 'u'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "u": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "run": { ".validate": "newData.isBoolean()" },
            "broken": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "rafts3": {
      ".indexOn": ["t"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['cells', 'dock', 'nick'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "cells": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24" },
        "dock": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "t": { ".validate": "newData.isNumber()" },
        "devs": {
          "$i": {
            ".validate": "newData.hasChildren(['id', 'u'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "u": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "run": { ".validate": "newData.isBoolean()" },
            "broken": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "bottles": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'nick', 'text', 't'])",
        "uid": { ".validate": "newData.isString()" },
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "raid": {
      "golem": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nick', 'role', 't'])",
            "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
            "role": { ".validate": "newData.val() === 'O2' || newData.val() === 'N2'" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "n": {
          ".write": "auth != null && (!data.exists() || root.child('raid/golem/players/' + auth.uid).exists())",
          "$k": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && ($k === 'N2' || $k === 'O2' || $k === 'He' || $k === 'Ar')"
          }
        },
        "round": { ".write": "auth != null && root.child('raid/golem/players/' + auth.uid).exists()", ".validate": "newData.isNumber()" },
        "doneRound": { ".write": "auth != null && root.child('raid/golem/players/' + auth.uid).exists()", ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "bases": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && ($id === auth.uid || root.child('parties/' + $id + '/members/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['name', 'color', 'members', 'tech', 'summary', 't'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 10" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
        "members": { "$u": { ".validate": "newData.isString() && newData.val().length <= 8" } },
        "tech": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
        "summary": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "devices": { "$i": {
          ".validate": "newData.hasChildren(['id', 'x', 'y'])",
          "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
          "run": { ".validate": "newData.isBoolean()" },
          "broken": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false } } },
        "map": {
          "x0": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
          "y0": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
          "s": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4096" },
          "w": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 64" },
          "h": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 48" },
          "rows": { "$i": { ".validate": "newData.isString() && newData.val().length <= 64" } },
          "$other": { ".validate": false } },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "partyCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && $code.matches(/^[A-Z2-9]{6}$/)"
      }
    },
    "parties": {
      "$pid": {
        ".read": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid && newData.child('members').child(auth.uid).exists()",
        "code": { ".validate": "newData.isString() && newData.val().length === 6" },
        "name": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 10"
        },
        "color": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "owner": { ".validate": "newData.isString()" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || newData.child('code').val() === root.child('parties/' + $pid + '/code').val())",
            ".validate": "newData.hasChildren(['nick', 't', 'code'])",
            "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
            "t": { ".validate": "newData.isNumber()" },
            "code": { ".validate": "newData.isString() && newData.val().length === 6" },
            "$other": { ".validate": false }
          }
        },
        "state": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['ver', 'raft', 'f', 'qDone', 'day', 'min']) && newData.child('ver').isNumber() && (!data.exists() ? newData.child('ver').val() === 1 : newData.child('ver').val() === data.child('ver').val() + 1)",
          "qDone": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
          "day": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "min": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
          "by": { ".validate": "newData.isString()" },
          "$other": { ".validate": true }
        },
        "lease": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid || data.child('exp').val() < now || data.child('active').val() === false)",
          ".validate": "newData.hasChildren(['uid', 'active', 'exp']) && newData.child('uid').val() === auth.uid && newData.child('active').isBoolean() && newData.child('exp').isNumber() && newData.child('exp').val() <= now + 20000"
        },
        "log": {
          ".indexOn": ["t"],
          "$id": {
            ".write": "auth != null && !data.exists() && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'nick', 'kind', 'text', 't']) && newData.child('uid').val() === auth.uid",
            "uid": { ".validate": "newData.isString()" },
            "nick": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "kind": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "partyPub": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$pid": {
        ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 10" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
        "motto": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "members": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4" },
        "qDone": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
        "planet": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "t": { ".validate": "newData.isNumber()" },
        "ship": {
          "cells": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24" },
          "devs": { "$i": {
            ".validate": "newData.hasChildren(['id', 'u', 'z'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "u": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "run": { ".validate": "newData.isBoolean()" },
            "broken": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false } } },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "trades": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$tid": {
        ".write": "auth != null && ((!data.exists() && root.child('parties/' + newData.child('fromPid').val() + '/members/' + auth.uid).exists()) || (data.exists() && data.child('status').val() === 'open' && newData.child('status').val() === 'taken' && root.child('parties/' + newData.child('takerPid').val() + '/members/' + auth.uid).exists() && newData.child('takerPid').val() !== data.child('fromPid').val()) || (data.exists() && data.child('status').val() === 'open' && newData.child('status').val() === 'cancelled' && root.child('parties/' + data.child('fromPid').val() + '/members/' + auth.uid).exists()) || (data.exists() && data.child('status').val() === 'taken' && newData.child('status').val() === 'done' && root.child('parties/' + data.child('fromPid').val() + '/members/' + auth.uid).exists()))",
        ".validate": "newData.hasChildren(['fromPid', 'fromName', 'give', 'want', 't', 'status']) && (newData.child('status').val() === 'open' || newData.child('status').val() === 'taken' || newData.child('status').val() === 'cancelled' || newData.child('status').val() === 'done')",
        "fromPid": { ".validate": "newData.isString()" },
        "fromName": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "give": { "$item": { ".validate": "$item.matches(/^(stick|sand|sea|ice|bottle|syringe|sugar|salt|water|noodle|ramen|dirt|stone|pickaxe|shaker|thermo)$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" } },
        "want": { "$item": { ".validate": "$item.matches(/^(stick|sand|sea|ice|bottle|syringe|sugar|salt|water|noodle|ramen|dirt|stone|pickaxe|shaker|thermo)$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" } },
        "paid": { "$item": { ".validate": "$item.matches(/^(stick|sand|sea|ice|bottle|syringe|sugar|salt|water|noodle|ramen|dirt|stone|pickaxe|shaker|thermo)$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" } },
        "t": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.isString()" },
        "takerPid": { ".validate": "newData.isString()" },
        "takerName": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "$other": { ".validate": false }
      }
    },
    "world": {
      "project": {
        ".read": "auth != null",
        "have": { "$item": {
          ".write": "auth != null",
          ".validate": "(($item === 'water' && newData.val() <= 3000) || ($item === 'salt' && newData.val() <= 300) || ($item === 'ice' && newData.val() <= 20)) && newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 500"
        } },
        "byTeam": { "$pid": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['name', 'n'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "n": { ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 200" },
          "$other": { ".validate": false } } },
        "done": {
          ".write": "auth != null",
          ".validate": "newData.val() === true && root.child('world/project/have/water').val() >= 3000 && root.child('world/project/have/salt').val() >= 300 && root.child('world/project/have/ice').val() >= 20"
        },
        "$other": { ".validate": false }
      }
    },
    "reports": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$rid": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('parties/' + newData.child('pid').val() + '/members/' + auth.uid).exists()",
        ".validate": "newData.hasChildren(['pid', 'teamName', 'uid', 'nick', 't', 'title', 'line'])",
        "pid": { ".validate": "newData.isString()" },
        "teamName": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
        "uid": { ".validate": "newData.isString()" },
        "nick": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "t": { ".validate": "newData.isNumber()" },
        "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "env": {
          "planet": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "P": { ".validate": "newData.isNumber()" },
          "dT": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false } },
        "line": {
          "type": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "day": { ".validate": "newData.isNumber()" },
          "clock": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "$other": { ".validate": false } },
        "votes": { "$vpid": {
          ".write": "auth != null && root.child('parties/' + $vpid + '/members/' + auth.uid).exists() && $vpid !== root.child('reports/' + $rid + '/pid').val()",
          ".validate": "newData.val() === 'ok' || newData.val() === 'diff'" } },
        "$other": { ".validate": false }
      }
    },
    "boards": {
      ".read": "auth != null",
      "$board": {
        ".indexOn": ["score"],
        "$pid": {
          ".write": "auth != null && ($board === 'env' || $board === 'core' || $board === 'water' || $board === 'predict') && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['name', 'score', 't'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "members": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + ($board === 'env' ? 3 : ($board === 'core' ? 60 : ($board === 'water' ? 2000 : 30))) && newData.val() <= 100000" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['inv', 'f'])"
      }
    },
    "saves3": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['inv', 'f', 'fp'])"
      }
    }
  }
}
