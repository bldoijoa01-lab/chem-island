{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nick', 'createdAt'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "nicks": {
      "$nick": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$nick.matches(/^[a-z0-9가-힣]{2,8}$/) && newData.val() === auth.uid"
      }
    },
    "presence": {
      "$map": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nick', 'x', 'y'])",
          "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 2000" },
          "vx": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
          "face": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)" },
          "air": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['inv', 'f'])"
      }
    }
  }
}
