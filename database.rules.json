{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nick', 'createdAt'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "nicks": {
      "$nick": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$nick.matches(/^[a-z0-9가-힣]{2,8}$/) && newData.val() === auth.uid"
      }
    },
    "presence": {
      "$map": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nick', 'x', 'y'])",
          "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 2000" },
          "vx": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
          "face": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)" },
          "air": { ".validate": "newData.isBoolean()" },
          "z": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 4000" },
          "yaw": { ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10" },
          "$other": { ".validate": false }
        }
      }
    },
    "rafts": {
      ".indexOn": ["t"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['cells', 'dock', 'nick'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "cells": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24" },
        "dock": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "t": { ".validate": "newData.isNumber()" },
        "devs": {
          "$i": {
            ".validate": "newData.hasChildren(['id', 'u'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "u": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "run": { ".validate": "newData.isBoolean()" },
            "broken": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "rafts3": {
      ".indexOn": ["t"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['cells', 'dock', 'nick'])",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "cells": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24" },
        "dock": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "t": { ".validate": "newData.isNumber()" },
        "devs": {
          "$i": {
            ".validate": "newData.hasChildren(['id', 'u'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "u": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
            "run": { ".validate": "newData.isBoolean()" },
            "broken": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "bottles": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'nick', 'text', 't'])",
        "uid": { ".validate": "newData.isString()" },
        "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "raid": {
      "golem": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nick', 'role', 't'])",
            "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
            "role": { ".validate": "newData.val() === 'O2' || newData.val() === 'N2'" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "n": {
          ".write": "auth != null && (!data.exists() || root.child('raid/golem/players/' + auth.uid).exists())",
          "$k": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && ($k === 'N2' || $k === 'O2' || $k === 'He' || $k === 'Ar')"
          }
        },
        "round": { ".write": "auth != null && root.child('raid/golem/players/' + auth.uid).exists()", ".validate": "newData.isNumber()" },
        "doneRound": { ".write": "auth != null && root.child('raid/golem/players/' + auth.uid).exists()", ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "partyCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && $code.matches(/^[A-Z2-9]{6}$/)"
      }
    },
    "parties": {
      "$pid": {
        ".read": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid && newData.child('members').child(auth.uid).exists()",
        "code": { ".validate": "newData.isString() && newData.val().length === 6" },
        "name": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 10"
        },
        "color": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "owner": { ".validate": "newData.isString()" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || (newData.child('code').val() === root.child('parties/' + $pid + '/code').val() && root.child('parties/' + $pid + '/members').numChildren() < 4))",
            ".validate": "newData.hasChildren(['nick', 't', 'code'])",
            "nick": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 8" },
            "t": { ".validate": "newData.isNumber()" },
            "code": { ".validate": "newData.isString() && newData.val().length === 6" },
            "$other": { ".validate": false }
          }
        },
        "state": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['ver', 'raft', 'f', 'qDone', 'day', 'min']) && newData.child('ver').isNumber() && (!data.exists() ? newData.child('ver').val() === 1 : newData.child('ver').val() === data.child('ver').val() + 1)",
          "qDone": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
          "day": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "min": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
          "by": { ".validate": "newData.isString()" },
          "$other": { ".validate": true }
        },
        "lease": {
          ".write": "auth != null && root.child('parties/' + $pid + '/members/' + auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid || data.child('exp').val() < now || data.child('active').val() === false)",
          ".validate": "newData.hasChildren(['uid', 'active', 'exp']) && newData.child('uid').val() === auth.uid && newData.child('active').isBoolean() && newData.child('exp').isNumber() && newData.child('exp').val() <= now + 20000"
        },
        "log": {
          ".indexOn": ["t"],
          "$id": {
            ".write": "auth != null && !data.exists() && root.child('parties/' + $pid + '/members/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'nick', 'kind', 'text', 't']) && newData.child('uid').val() === auth.uid",
            "uid": { ".validate": "newData.isString()" },
            "nick": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "kind": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['inv', 'f'])"
      }
    },
    "saves3": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['inv', 'f', 'fp'])"
      }
    }
  }
}
